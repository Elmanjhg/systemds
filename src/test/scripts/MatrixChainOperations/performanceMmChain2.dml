M1 = rand(rows=1000, cols=200, sparsity=1.0)
M2 = rand(rows=500,  cols=200, sparsity=1.0)
M3 = rand(rows=500,  cols=100, sparsity=1.0)
M4 = rand(rows=100,  cols=800, sparsity=1.0)

M5 = rand(rows=600,  cols=300, sparsity=1.0)
M6 = rand(rows=300,  cols=800, sparsity=1.0) 

M7 = rand(rows=600,  cols=150, sparsity=1.0)
M8 = rand(rows=900,  cols=150, sparsity=1.0)

R = M1 %*% t(M2) %*% M3 %*% M4 %*% t(M5 %*% M6) %*% M7 %*% t(M8)

write(R, "output_R2.csv")
